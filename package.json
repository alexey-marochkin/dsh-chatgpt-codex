{
  "name": "dsh-chatgpt-codex",
  "version": "0.6.3",
  "description": "ChatGPT - Codex: подключение подписки ChatGPT в DSH",
  "type": "module",
  "license": "MIT",
  "author": "Alexey Marochkin",
  "homepage": "https://devos.aicent.ru/dsh-plugins/chatgpt-codex/",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexey-marochkin/dsh-chatgpt-codex.git"
  },
  "bugs": {
    "url": "https://github.com/alexey-marochkin/dsh-chatgpt-codex/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "chatgpt",
    "codex",
    "oauth",
    "quota",
    "developer-os"
  ],
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSE-LUCIDE",
    "journal.js",
    "quota.js",
    "resets.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "1.3.0"
  }
}
